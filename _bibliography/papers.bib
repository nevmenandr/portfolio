@article{Orekhov2015bashmorph, 
  abbr={DH},
  title={Сетевой подход к описанию башкирской морфологии},
  abstract={Статья посвящена современному, основанному на теории графов (в западной терминологии — сетей), подходу к описанию свойственной тюркским языкам морфологической агглютинативности. Хотя в целом сети использовались в теоретической лингвистике и ранее, морфология оказалась почти не затронута таким методом описания. Меж тем, именно в случае агглютинативной морфологии он дает существенные преимущества, позволяя установить закономерности в сочетании аффиксов, выявить типичное и нетипичное поведение морфем и морфов, предложить лингвистически оправданное описание редких, но любопытных с точки зрения теории языка случаев контактного сочетания одинаковых морфем (но разных морфов).},
